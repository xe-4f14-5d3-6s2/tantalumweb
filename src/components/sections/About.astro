---
import pcimg from "@/assets/pc.webp";

import { socials } from "@/lib/config";
import { Icon } from "astro-icon/components";
---

<section
  id="about"
  class="flex flex-col lg:flex-row gap-10 min-h-dvh px-8 lg:px-12 justify-center items-center bg-linear-to-b from-black to-gray-900"
>
  <div class="lg:w-[50%] flex flex-col justify-between">
    <h2
      class="text-4xl md:text-6xl font-black text-left mb-10 bg-linear-to-r to-sky-300 from-indigo-700 bg-clip-text text-transparent"
    >
      ABOUT ME
    </h2>
    <p
      class="text-2xl tracking-tight leading-none mb-10 font-light text-gray-400"
    >
      As a software developer and soon-to-be physicist, I bring six years of
      expertise in full-stack web and software development. Alongside my Physics
      studies at UNC (Universidad Nacional de las Ciencias Dr. Humberto
      Fernández Morán), I am proud to be one of the national champions of the
      2026 Venezuelan Astronomy Olympiad, with my sights set on representing my
      country at the OWAO.
      <br /><br />
      My ultimate goal is simple: to build clean, highly optimized code and use technology
      to deliver meaningful solutions to real-world challenges.
    </p>
    <div class="flex gap-6">
      {
        socials.map((social) => (
          <a href={social.href} class="text-4xl">
            <Icon name={social.icon} />
          </a>
        ))
      }
    </div>
  </div>
  <div class="w-[50%] hidden lg:flex">
    <img
      class="w-full object-contain rounded-4xl mask-x-from-70% mask-x-to-90% mask-y-from-70% mask-y-to-90%"
      src={pcimg.src}
      alt=""
    />
  </div>
</section>

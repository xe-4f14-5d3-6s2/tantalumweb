---
import { socials } from "@/lib/config";
import { Icon } from "astro-icon/components";
---

<footer
  class="py-6 mx-6 border-t border-t-gray-900 flex justify-between items-center text-gray-400"
>
  <p class="text-xs lg:text-base">2026 TANTALUMDEV. ALL RIGHTS RESERVED.</p>
  <div class="flex gap-6">
    {
      socials.map((social) => (
        <a href={social.href} target="_blank" class="text-xl">
          <Icon name={social.icon} />
        </a>
      ))
    }
  </div>
</footer>

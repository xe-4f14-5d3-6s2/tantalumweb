---
import bgimg from "@/assets/background.webp";
import Button from "@/components/Button.astro";

import { ChevronDown } from "@lucide/astro";
---

<header class="flex justify-center items-center h-dvh">
  <div
    class="z-0 opacity-60 h-dvh w-dvw absolute bg-center bg-no-repeat bg-origin-border mask-b-to-85% mask-b-from-15%"
    style={"background-image: url(" + bgimg.src + ");"}
  >
  </div>
  <div class="z-1 flex flex-col justify-center items-center">
    <h3
      class="text-2xl text-sky-300 text-center mb-6 tracking-widest font-bold"
    >
      PHYSICIST & DEVELOPER
    </h3>
    <h1
      class="font-black text-6xl md:text-8xl lg:text-[10rem] tracking-tighter leading-none text-center mb-6"
    >
      tan<span
        id="title-parentesis-1"
        class="inline-block whitespace-nowrap w-0 p-0 m-0 opacity-0 text-slate-400"
        >(</span
      ><span id="title-talum">talum</span><span
        class="inline-block whitespace-nowrap w-0 opacity-0 p-0 m-0 text-slate-400"
        id="title-parentesis-2">)</span
      >
    </h1>
    <p
      class="text-slate-400 text-2xl text-center mb-10 tracking-tighter font-light"
    >
      Building digital experiences that blur the line between reality and the
      web.
    </p>

    <Button filled={false} link="#">EXPLORE WORK <ChevronDown /> </Button>
  </div>
</header>

<script>
  import { gsap } from "gsap";

  gsap.to("#title-parentesis-1", {
    width: "auto",
    opacity: 1,
    delay: 1.5,
    duration: 0.8,
    ease: "power3.out",
  });

  gsap.to("#title-parentesis-2", {
    width: "auto",
    opacity: 1,
    delay: 1.5,
    duration: 0.8,
    ease: "power3.out",
                           });

                           gsap.to("#title-talum", {
                           color: "#c6d2ff",
                            delay: 1.9,
                            duration: 0.5
                           })
</script>

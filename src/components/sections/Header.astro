---
import bgimg from "@/assets/background.webp";
import Button from "@/components/Button.astro";

import { Icon } from "astro-icon/components";
---

<header class="flex justify-center items-center h-dvh">
  <div
    class="z-0 opacity-50 h-dvh w-dvw absolute bg-center bg-no-repeat bg-origin-border mask-b-to-85% mask-b-from-15%"
    style={"background-image: url(" + bgimg.src + ");"}
  >
  </div>
  <div class="z-1 flex flex-col justify-center items-center">
    <h3
      id="title-top"
      class="opacity-0 text-2xl text-sky-300 text-center mb-6 tracking-widest font-bold"
    >
      PHYSICIST & DEVELOPER
    </h3>
    <h1
      class="font-black text-6xl md:text-8xl lg:text-[10rem] tracking-tighter leading-none text-center mb-6"
    >
      tan<span
        id="title-parentesis-1"
        class="inline-block whitespace-nowrap w-0 p-0 m-0 opacity-0 text-slate-400"
        >(</span
      ><span id="title-talum">talum</span><span
        class="inline-block whitespace-nowrap w-0 opacity-0 p-0 m-0 text-slate-400"
        id="title-parentesis-2">)</span
      >
    </h1>
    <p
      id="title-bottom"
      class="opacity-0 text-white text-2xl text-center mb-10 tracking-tighter font-light"
    >
      Building digital experiences that blur the line between reality and the
      web.
    </p>
    <span class="opacity-0" id="title-button">
      <Button filled={false} link="#"
        >EXPLORE WORK <Icon name="tabler:chevron-down" />
      </Button>
    </span>
  </div>
</header>

<script>
  import { gsap } from "gsap";

  let timeline = gsap.timeline();

  timeline
    .to("#title-parentesis-1", {
      width: "auto",
      opacity: 1,
      delay: 1,
      duration: 0.8,
      ease: "power1.out",
    })
    .to(
      "#title-parentesis-2",
      {
        width: "auto",
        delay: 1,
        opacity: 1,
        duration: 0.8,
        ease: "power1.out",
      },
      0,
    )
    .to("#title-talum", {
      color: "#c6d2ff",
      duration: 0.2,
    })
    .fromTo(
      "#title-top",
      {
        y: 100,
      },
      {
        y: 0,
        opacity: 1,
        ease: "expo.out",
      },
    )
    .fromTo(
      "#title-bottom",
      {
        y: -100,
      },
      {
        y: 0,
        opacity: 1,
        ease: "expo.out",
      },
      "<50%",
    )
    .to("#title-button", {
      opacity: 1,
    });
</script>

---
import Button from "../Button.astro";
---

<section
    class="min-h-dvh bg-linear-to-b from-gray-900 to-black p-8 md:p-12 flex flex-col justify-center items-center"
    id="connect"
>
  <h3 class="text-4xl md:text-6xl font-black mb-6 text-center">
    READY TO <span class="text-sky-300">CONNECT</span>?
  </h3>
  <p class="mb-12 text-gray-400 leading-none tracking-tighter text-2xl text-center">
    Currently open for new opportunities. Let's build something exceptional
    together.
  </p>
  <Button link="#about" filled>CONTACT ME</Button>
</section>

---
interface Props {
  img: string;
  subname: string;
  name: string;
  description: string;
  techs: string[];
  link: string;
  side:string,
}

const { img, subname, name, description, techs, link, side } = Astro.props;

import { Icon } from "astro-icon/components";

---

<div class={"flex gap-20 "+side}>
  <div class="w-[50%]">
    <img src={img} class="w-full" alt={description} />
  </div>
  <div class="w-[50%] flex flex-col text-left justify-between my-4">
    <p class="text-2xl tracking-wide font-bold text-indigo-200">{subname}</p>
    <h3 class="text-5xl font-black">{name}</h3>
    <p class="text-2xl tracking-tighter leading-none text-gray-400 font-light">
      {description}
    </p>

    <div class="flex gap-5">
      {
        techs.map((tech) => (
          <p class="tracking-tight text-center p-2 border border-gray-400 text-sm rounded-2xl">
            {tech}
          </p>
        ))
      }
    </div>

    <a
      href={link}
      class="flex gap-2 justify-center items-center text-2xl font-bold tracking-wider"
      >VIEW DETAILS <Icon name="tabler:external-link" /></a
    >
  </div>
</div>

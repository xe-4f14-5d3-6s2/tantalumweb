---
interface Props {
  link: string;
  filled: boolean;
}

const { link, filled } = Astro.props;

const css = filled
  ? "bg-white hover:bg-slate-100 focus:bg-slate-200 hover:border-slate-100 focus:border-slate-200 text-black"
  : "bg-transparent hover:text-black hover:bg-white focus:bg-slate-100 focus:text-black focus:border-slate-100";
---

<a
  href={link}
  class={"flex justify-center items-center transition p-4 px-8 border-2 border-white text-2xl font-bold tracking-tight text-center cursor-pointer " +
    css}
>
  <slot />
</a>
